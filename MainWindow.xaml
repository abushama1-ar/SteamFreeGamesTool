<Window x:Class="SteamFreeGamesTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Steam Tool - النسخة الاحترافية (مشروع مفتوح المصدر انا بديت فيه انته كمله)" Height="550" Width="800" 
        Background="#121212" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
    
    <TabControl x:Name="MainTabControl" Background="#181818" Foreground="White" BorderThickness="0">
        
        

        <TabItem x:Name="TabDistribution" Header="توزيع الألعاب" Padding="15,5" IsEnabled="True">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#333" BorderThickness="2" CornerRadius="10" Background="#1E1E1E" 
                        AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" Margin="0,0,0,15">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📦 اسحب ملف الـ ZIP هنا" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="لتوزيع الترخيص وتثبيت اللعبة عبر Nova System" Foreground="#888" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Grid.Row="1" Text="جاهز للعمليات..." Foreground="#00FF66" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Button Grid.Row="2" Content="🔄 إعادة تشغيل ستيم (Restart Steam)" Click="BtnRestartSteam_Click" 
                        Background="#2D2D2D" Foreground="White" FontSize="14" FontWeight="Bold" Padding="10,12" Cursor="Hand"/>
            </Grid>
        </TabItem>

        <!-- Tab 2: ألعاب البرنامج وإدارتها (مغلق حتى يتم تسجيل الدخول) -->
        <TabItem x:Name="TabManagement" Header="ألعاب البرنامج وإدارتها" Padding="15,5" IsEnabled="True">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="NovaGamesListBox" Grid.Row="0" Background="#1A1A1A" Foreground="White" BorderBrush="#333" Margin="0,0,0,15">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center">
                                <TextBlock Text="🎮 " Foreground="#00FF66"/>
                                <TextBlock Text="{Binding}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBox x:Name="DeleteGameInput" Width="300" Height="35" Background="#222" Foreground="White" BorderBrush="#444" VerticalContentAlignment="Center" Padding="5" Margin="0,0,10,0"/>
                    <Button Content="🗑️ حذف اللعبة بالاسم أو AppID" Click="BtnDeleteGameByInput_Click" Background="#8B0000" Foreground="White" Padding="15,8" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </TabItem>

    <!-- قسم GitHub الاحترافي -->
    <TabItem Header="GitHub" Padding="15,5">
<Grid x:Name="PanelGithub" Margin="20">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- العنوان -->
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
        <TextBlock Text="NOVA SYSTEM - GitHub" Foreground="#CDD6F4" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="مستودعات الأدوات المفتوحة المصدر" Foreground="#6C7086" FontSize="12"/>
    </StackPanel>

    <!-- بطاقة المحتوى -->
    <Border Grid.Row="1" Background="#181825" CornerRadius="8" Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="رابط المستودع الرسمي:" Foreground="#BAC2DE" Margin="0,0,0,10"/>
            <TextBlock Text="https://github.com/abushama1-ar/Nova_Premium"
                       Foreground="#89B4FA" FontWeight="Bold" Margin="0,0,0,15"/>
            
                <Button Content="فتح المستودع على GitHub" Click="BtnOpenGithub_Click"
                    Background="#89B4FA" Foreground="#11111B" BorderThickness="0"
                    Padding="10" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,0,0,20"/>

            <!-- لوج التنفيذ -->
            <TextBox x:Name="GithubLogBox" Height="150" IsReadOnly="True" Background="#11111B" 
                     Foreground="#A6E3A1" BorderBrush="#313244" FontFamily="Consolas" 
                     Padding="10" AcceptsReturn="True" TextWrapping="Wrap" 
                     Text="جاري الاستعداد لإطلاق الأدوات... كل شيء سيكون مفتوح المصدر قريباً!"/>
        </StackPanel>
    </Border>

    <!-- زر التنبيه -->
    <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="8" Padding="15" Margin="0,15,0,0" BorderBrush="#313244" BorderThickness="1">
        <TextBlock Text="🚀 مستودعات nova system رسمياً قريباً.. شكراً لثقتكم!" 
                   Foreground="#89B4FA" HorizontalAlignment="Center" FontWeight="Bold"/>
    </Border>
      </Grid>
        </TabItem>
    </TabControl>
</Window>